# Copie este arquivo para .env e preencha.

# WhatsApp via CallMeBot (veja o README para pegar a chave)
CALLMEBOT_PHONE=+5511999999999
CALLMEBOT_APIKEY=

# SerpApi (https://serpapi.com, 250 buscas/mês grátis): preço das agências (Zupper etc.)
# e reserva caso o Google Flights falhe
SERPAPI_KEY=

# Notificações no celular pelo app ntfy (https://ntfy.sh). Use um nome difícil de adivinhar:
# quem souber o nome consegue ler as mensagens.
NTFY_TOPIC=

# Interface no celular (atalho "Flight Scanner (celular).cmd"): a senha de quem entra pela rede.
# Pode ficar em branco: o programa gera um token aleatório na primeira vez. Para trocar o token,
# apague o valor. Quem tiver o token controla a interface; não o compartilhe.
INTERFACE_TOKEN=
